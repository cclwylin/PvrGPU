+void WrappedOpenGL::EndActiveReplayScopes(bool recordFeedbackResume)
+{
+  if(!IsActiveReplaying(m_State) || m_FetchCounters)
+    return;
+
+  // This is the existing standalone replay cleanup, shared by seek/reset,
+  // shutdown, and non-continuous replay. Continuous ranges leave these scopes
+  // open for the capture's real End commands in a later range.
+  for(size_t i = 0; i < MAX_QUERIES; i++)
+  {
+    GLenum q = QueryEnum(i);
+    if(q == eGL_NONE)
+      break;
+
+    int indices = IsGLES ? 1 : MAX_QUERY_INDICES;
+    for(int j = 0; j < indices; j++)
+    {
+      if(m_ActiveQueries[i][j])
+      {
+        if(IsGLES)
+          GL.glEndQuery(q);
+        else
+          GL.glEndQueryIndexed(q, j);
+        m_ActiveQueries[i][j] = false;
+      }
+    }
+  }
+
+  if(m_ActiveConditional)
+  {
+    GL.glEndConditionalRender();
+    m_ActiveConditional = false;
+  }
+
+  if(m_ActiveFeedback)
+  {
+    GL.glEndTransformFeedback();
+    m_ActiveFeedback = false;
+    if(recordFeedbackResume)
+      m_WasActiveFeedback = true;
+  }
+}
