diff --git a/renderdoc/replay/replay_snapshot.h b/renderdoc/replay/replay_snapshot.h
new file mode 100644
--- /dev/null
+++ b/renderdoc/replay/replay_snapshot.h
@@ -0,0 +1,26 @@
+#pragma once
+
+// Private, opt-in API. No change to IReplayController's public vtable.
+#include "api/replay/renderdoc_replay.h"
+
+extern "C" RENDERDOC_EXPORT_API uint32_t RENDERDOC_CC RENDERDOC_GetReplaySnapshotVersion();
+extern "C" RENDERDOC_EXPORT_API int RENDERDOC_CC RENDERDOC_SaveReplaySnapshot(
+    IReplayController *controller, uint32_t event, const char *path, const char *capture_sha256,
+    char *error, size_t errorSize);
+extern "C" RENDERDOC_EXPORT_API int RENDERDOC_CC RENDERDOC_LoadReplaySnapshot(
+    IReplayController *controller, const char *path, const char *capture_sha256, uint32_t *event,
+    char *error, size_t errorSize);
+
+class IReplayDriver;
+class GLReplay;
+rdcstr SaveGLReplaySnapshot(IReplayDriver *, uint32_t, const char *, const char *);
+rdcstr LoadGLReplaySnapshot(IReplayDriver *, const char *, const char *, uint32_t &);
+void RegisterGLSnapshotDriver(GLReplay *);
+void UnregisterGLSnapshotDriver(GLReplay *);
+class GLResourceManager;
+struct GLResource;
+void ValidateGLSnapshotResource(GLResourceManager *, const GLResource &, ResourceId);
+bool IsGLReplaySnapshotActive();
+void ReadGLReplaySnapshotTexture(uint32_t target, int level, uint32_t format, uint32_t type,
+                                 void *pixels, size_t bytes);
+int GetGLReplaySnapshotMipCount(uint32_t target, uint32_t texture);
diff --git a/renderdoc/replay/replay_snapshot_api.inl b/renderdoc/replay/replay_snapshot_api.inl
new file mode 100644
--- /dev/null
+++ b/renderdoc/replay/replay_snapshot_api.inl
@@ -0,0 +1,58 @@
+// Included by replay_controller.cpp; deliberately not part of the public vtable.
+static int SnapshotResult(const rdcstr &message, char *error, size_t size)
+{
+  if(error && size)
+  {
+    size_t count = RDCMIN(size - 1, message.size());
+    memcpy(error, message.c_str(), count);
+    error[count] = 0;
+  }
+  return message.empty() ? 0 : 1;
+}
+
+extern "C" RENDERDOC_EXPORT_API uint32_t RENDERDOC_CC RENDERDOC_GetReplaySnapshotVersion()
+{
+  return 1;
+}
+
+extern "C" RENDERDOC_EXPORT_API int RENDERDOC_CC RENDERDOC_SaveReplaySnapshot(
+    IReplayController *controller, uint32_t event, const char *path, const char *capture_sha256,
+    char *error, size_t errorSize)
+{
+  auto found = snapshotControllers.find(controller);
+  if(found == snapshotControllers.end())
+    return SnapshotResult("snapshot: invalid or foreign controller", error, errorSize);
+  ReplayController *c = found->second;
+  if(!c->SnapshotThread())
+    return SnapshotResult("snapshot: wrong replay thread", error, errorSize);
+  if(!event || c->SnapshotEvent() != event || !snapshotUsedControllers.count(controller))
+    return SnapshotResult("snapshot: boundary is not the completed current event", error, errorSize);
+  return SnapshotResult(SaveGLReplaySnapshot(c->SnapshotDevice(), event, path, capture_sha256),
+                        error, errorSize);
+}
+
+extern "C" RENDERDOC_EXPORT_API int RENDERDOC_CC RENDERDOC_LoadReplaySnapshot(
+    IReplayController *controller, const char *path, const char *capture_sha256, uint32_t *event,
+    char *error, size_t errorSize)
+{
+  if(event)
+    *event = 0;
+  auto found = snapshotControllers.find(controller);
+  if(found == snapshotControllers.end() || !event)
+    return SnapshotResult("snapshot: invalid controller or output event pointer", error, errorSize);
+  ReplayController *c = found->second;
+  if(!c->SnapshotThread())
+    return SnapshotResult("snapshot: wrong replay thread", error, errorSize);
+  if(snapshotUsedControllers.count(controller))
+    return SnapshotResult("snapshot: load requires an unused fresh controller", error, errorSize);
+  // A failed import may have modified temporary/live objects. Never reuse it.
+  snapshotUsedControllers.insert(controller);
+  uint32_t restored = 0;
+  rdcstr result = LoadGLReplaySnapshot(c->SnapshotDevice(), path, capture_sha256, restored);
+  if(result.empty())
+  {
+    c->SnapshotSetEvent(restored);
+    *event = restored;
+  }
+  return SnapshotResult(result, error, errorSize);
+}
