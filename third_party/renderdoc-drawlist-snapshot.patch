--- /dev/null
+++ b/renderdoc/driver/gl/gl_replay_snapshot.inl
@@ -0,0 +1,1060 @@
+// Private functional GL checkpoint v1. Included in gl_replay.cpp so the extension
+// can be built with a few isolated objects without changing public class layouts.
+// This is not a GPU cache, clock, pending-work, or cycle-accurate checkpoint.
+#include <array>
+#include <fstream>
+#include <stdexcept>
+#include <vector>
+#include <cerrno>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <CommonCrypto/CommonDigest.h>
+
+namespace replay_snapshot
+{
+using Bytes = std::vector<byte>;
+constexpr uint64_t MaxBlob = 256ULL * 1024 * 1024;
+constexpr uint64_t MaxArchive = 2ULL * 1024 * 1024 * 1024;
+constexpr uint64_t MaxObjects = 16384;
+static std::map<IReplayDriver *, GLReplay *> drivers;
+static thread_local GLResourceManager *resolving = NULL;
+static thread_local const std::set<ResourceId> *allowed = NULL;
+
+static void Require(bool condition, const char *message)
+{
+  if(!condition)
+    throw std::runtime_error(message);
+}
+
+static uint64_t ID(ResourceId id)
+{
+  static_assert(sizeof(id) == sizeof(uint64_t), "ResourceId archive width");
+  uint64_t value;
+  memcpy(&value, &id, sizeof(value));
+  return value;
+}
+static ResourceId ID(uint64_t value)
+{
+  ResourceId id;
+  memcpy(&id, &value, sizeof(value));
+  return id;
+}
+
+struct Writer
+{
+  Bytes bytes;
+  void Raw(const void *p, size_t n)
+  {
+    Require(n <= MaxArchive && bytes.size() <= MaxArchive - n, "snapshot archive size limit");
+    if(n)
+      bytes.insert(bytes.end(), (const byte *)p, (const byte *)p + n);
+  }
+  void U64(uint64_t v)
+  {
+    for(unsigned i = 0; i < 8; ++i)
+      bytes.push_back(byte(v >> (8 * i)));
+  }
+  void Blob(const Bytes &b) { U64(b.size()); Raw(b.data(), b.size()); }
+  void String(const rdcstr &s) { U64(s.size()); Raw(s.data(), s.size()); }
+};
+struct Reader
+{
+  const Bytes &bytes;
+  size_t at = 0;
+  explicit Reader(const Bytes &b) : bytes(b) {}
+  void Raw(void *p, size_t n)
+  {
+    Require(n <= bytes.size() - at, "snapshot truncated field");
+    if(n)
+      memcpy(p, bytes.data() + at, n);
+    at += n;
+  }
+  uint64_t U64()
+  {
+    byte raw[8]; Raw(raw, 8);
+    uint64_t value = 0;
+    for(unsigned i = 0; i < 8; ++i)
+      value |= uint64_t(raw[i]) << (8 * i);
+    return value;
+  }
+  Bytes Blob(uint64_t limit = MaxBlob)
+  {
+    uint64_t n = U64();
+    Require(n <= limit && n <= bytes.size() - at, "snapshot invalid blob length");
+    Bytes b((size_t)n); Raw(b.data(), b.size()); return b;
+  }
+  rdcstr String(uint64_t limit = 4096)
+  {
+    Bytes b = Blob(limit);
+    return rdcstr((const char *)b.data(), b.size());
+  }
+  void Done() { Require(at == bytes.size(), "snapshot trailing bytes"); }
+};
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+static std::array<byte, 32> Digest(const Bytes &bytes)
+{
+  std::array<byte, 32> hash;
+  CC_SHA256(bytes.data(), (CC_LONG)bytes.size(), hash.data());
+  return hash;
+}
+#pragma clang diagnostic pop
+
+static void CheckCapture(const char *sha)
+{
+  Require(sha && strlen(sha) == 64, "snapshot requires a 64-character capture SHA-256");
+  for(size_t i = 0; i < 64; ++i)
+    Require((sha[i] >= '0' && sha[i] <= '9') || (sha[i] >= 'a' && sha[i] <= 'f'),
+            "snapshot capture SHA-256 must be lowercase hexadecimal");
+}
+static void CheckGL(const char *operation)
+{
+  GLenum error = GL.glGetError();
+  if(error != eGL_NONE)
+    throw std::runtime_error(std::string("snapshot GL error during ") + operation + ": " +
+                             std::to_string((unsigned)error));
+}
+static void Publish(const char *path, const Bytes &payload)
+{
+  Require(path && *path, "snapshot path is empty");
+  Writer archive;
+  const char magic[8] = {'R','D','G','L','S','N','0','1'};
+  archive.Raw(magic, 8);
+  archive.U64(payload.size());
+  auto hash = Digest(payload);
+  archive.Raw(hash.data(), hash.size());
+  archive.Raw(payload.data(), payload.size());
+  std::string temporary = std::string(path) + ".writing.XXXXXX";
+  std::vector<char> name(temporary.begin(), temporary.end()); name.push_back(0);
+  int fd = mkstemp(name.data());
+  Require(fd >= 0, "cannot create snapshot temporary file");
+  bool okay = true;
+  size_t at = 0;
+  while(at < archive.bytes.size())
+  {
+    ssize_t count = write(fd, archive.bytes.data() + at, archive.bytes.size() - at);
+    if(count < 0 && errno == EINTR) continue;
+    if(count <= 0) { okay = false; break; }
+    at += (size_t)count;
+  }
+  if(fsync(fd) != 0) okay = false;
+  if(close(fd) != 0) okay = false;
+  // link is atomic and fails if the requested final name already exists.
+  if(okay && link(name.data(), path) != 0) okay = false;
+  unlink(name.data());
+  Require(okay, "snapshot write/publish failed (existing files are never overwritten)");
+}
+static Bytes ReadArchive(const char *path)
+{
+  Require(path && *path, "snapshot path is empty");
+  struct Input
+  {
+    int fd;
+    explicit Input(const char *name) : fd(open(name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK)) {}
+    ~Input() { if(fd >= 0) close(fd); }
+  } input(path);
+  Require(input.fd >= 0, "cannot open snapshot regular archive (symlinks are refused)");
+  struct stat info;
+  Require(fstat(input.fd, &info) == 0 && S_ISREG(info.st_mode) && info.st_size >= 48 &&
+              uint64_t(info.st_size) <= MaxArchive, "snapshot regular archive length is invalid");
+  Bytes file(size_t(info.st_size));
+  size_t at = 0;
+  while(at < file.size())
+  {
+    ssize_t count = read(input.fd, file.data() + at, file.size() - at);
+    if(count < 0 && errno == EINTR) continue;
+    Require(count > 0, "snapshot archive read failed or was truncated");
+    at += size_t(count);
+  }
+  byte extra;
+  Require(read(input.fd, &extra, 1) == 0, "snapshot archive grew during read");
+  Reader reader(file);
+  char magic[8]; reader.Raw(magic, 8);
+  Require(memcmp(magic, "RDGLSN01", 8) == 0, "snapshot magic/version mismatch");
+  uint64_t size = reader.U64();
+  Require(size == file.size() - 48, "snapshot payload length mismatch");
+  std::array<byte, 32> expected; reader.Raw(expected.data(), expected.size());
+  Bytes payload((size_t)size); reader.Raw(payload.data(), payload.size()); reader.Done();
+  Require(Digest(payload) == expected, "snapshot payload SHA-256 mismatch");
+  return payload;
+}
+
+struct Resource
+{
+  ResourceId id;
+  GLNamespace type;
+  Bytes signature, blob;
+  std::map<GLint, GLint> locations;
+};
+}
+
+bool IsGLReplaySnapshotActive()
+{
+  return replay_snapshot::resolving != NULL;
+}
+
+int GetGLReplaySnapshotMipCount(uint32_t targetValue, uint32_t texture)
+{
+  // MAX_LEVEL is sampling state, not the physical allocation inventory. The
+  // suffix can expose currently hidden levels, which must survive a checkpoint.
+  GLenum target = GLenum(targetValue);
+  GLint immutable = 0, levels = 0;
+  GL.glGetTextureParameterivEXT(texture, target, eGL_TEXTURE_IMMUTABLE_FORMAT, &immutable);
+  if(immutable)
+    GL.glGetTextureParameterivEXT(texture, target, eGL_TEXTURE_IMMUTABLE_LEVELS, &levels);
+  else
+  {
+    GLint maximum = 0;
+    GL.glGetIntegerv(target == eGL_TEXTURE_3D ? eGL_MAX_3D_TEXTURE_SIZE :
+                     target == eGL_TEXTURE_CUBE_MAP || target == eGL_TEXTURE_CUBE_MAP_ARRAY ?
+                     eGL_MAX_CUBE_MAP_TEXTURE_SIZE : eGL_MAX_TEXTURE_SIZE, &maximum);
+    replay_snapshot::Require(maximum > 0, "snapshot mutable texture limit query failed");
+    int possibleLevels = 1;
+    while(maximum > 1) { maximum >>= 1; ++possibleLevels; }
+    possibleLevels = RDCMIN(possibleLevels, 16);
+    if(target == eGL_TEXTURE_CUBE_MAP) target = eGL_TEXTURE_CUBE_MAP_POSITIVE_X;
+    bool missing = false;
+    for(int level = 0; level < possibleLevels; ++level)
+    {
+      GLint width = 0;
+      GL.glGetTextureLevelParameterivEXT(texture, target, level, eGL_TEXTURE_WIDTH, &width);
+      if(width == 0) missing = true;
+      else
+      {
+        replay_snapshot::Require(!missing, "snapshot v1 refuses holes in mutable texture storage");
+        levels = level + 1;
+      }
+    }
+  }
+  replay_snapshot::CheckGL("physical mip inventory");
+  replay_snapshot::Require(levels > 0 && levels <= 16, "snapshot physical mip count is invalid");
+  return levels;
+}
+
+void ReadGLReplaySnapshotTexture(uint32_t targetValue, int level, uint32_t formatValue,
+                                 uint32_t typeValue, void *pixels, size_t bytes)
+{
+  // GLES glGetTexImage emulation may execute shader conversions (notably for
+  // depth and RGB). A checkpoint may only preserve actual raw texture data.
+  // Use direct FBO readback, rejecting a driver/format that cannot support it.
+  using replay_snapshot::Require;
+  GLenum target = GLenum(targetValue), format = GLenum(formatValue), type = GLenum(typeValue);
+  GLint width = 0, height = 0, depth = 0, texture = 0;
+  GL.glGetTexLevelParameteriv(target, level, eGL_TEXTURE_WIDTH, &width);
+  GL.glGetTexLevelParameteriv(target, level, eGL_TEXTURE_HEIGHT, &height);
+  GL.glGetTexLevelParameteriv(target, level, eGL_TEXTURE_DEPTH, &depth);
+  GL.glGetIntegerv(TextureBinding(target), &texture);
+  const bool layered = target == eGL_TEXTURE_3D || target == eGL_TEXTURE_2D_ARRAY ||
+                       target == eGL_TEXTURE_CUBE_MAP_ARRAY;
+  const int layers = layered ? depth : 1;
+  Require(width > 0 && height > 0 && layers > 0 && texture,
+          "snapshot raw texture read has invalid storage");
+  uint64_t sliceBytes = GetByteSize(uint32_t(width), uint32_t(height), 1, format, type);
+  Require(sliceBytes && sliceBytes <= bytes && uint64_t(layers) == bytes / sliceBytes &&
+              bytes % sliceBytes == 0, "snapshot raw texture read extent mismatch");
+  GLenum attachment = eGL_COLOR_ATTACHMENT0;
+  if(format == eGL_DEPTH_COMPONENT) attachment = eGL_DEPTH_ATTACHMENT;
+  if(format == eGL_STENCIL_INDEX) attachment = eGL_STENCIL_ATTACHMENT;
+  if(format == eGL_DEPTH_STENCIL) attachment = eGL_DEPTH_STENCIL_ATTACHMENT;
+  const unsigned narrowChannels = type == eGL_UNSIGNED_BYTE ?
+      (format == eGL_RED ? 1U : format == eGL_RG ? 2U : format == eGL_RGB ? 3U : 0U) : 0U;
+  // GLES guarantees normalized RGBA8 readback, not RGB/RED/RG byte reads.
+  // Discard only synthetic unused channels on the CPU; preserve every stored
+  // component bit. This is packing, not shader/color-space conversion.
+  replay_snapshot::Bytes rgba;
+  if(narrowChannels)
+  {
+    uint64_t readBytes = uint64_t(width) * uint64_t(height) * 4;
+    Require(readBytes <= replay_snapshot::MaxBlob, "snapshot RGBA readback scratch limit");
+    rgba.resize(size_t(readBytes));
+  }
+  struct ReadGuard
+  {
+    GLuint fbo = 0; GLint previousFBO = 0, packBuffer = 0;
+    PixelPackState pack;
+    ReadGuard()
+    {
+      GL.glGetIntegerv(eGL_READ_FRAMEBUFFER_BINDING, &previousFBO);
+      GL.glGetIntegerv(eGL_PIXEL_PACK_BUFFER_BINDING, &packBuffer);
+      pack.Fetch(false); ResetPixelPackState(false, 1);
+      GL.glBindBuffer(eGL_PIXEL_PACK_BUFFER, 0);
+      GL.glGenFramebuffers(1, &fbo); GL.glBindFramebuffer(eGL_READ_FRAMEBUFFER, fbo);
+    }
+    ~ReadGuard()
+    {
+      GL.glBindFramebuffer(eGL_READ_FRAMEBUFFER, GLuint(previousFBO));
+      GL.glDeleteFramebuffers(1, &fbo);
+      pack.Apply(false); GL.glBindBuffer(eGL_PIXEL_PACK_BUFFER, GLuint(packBuffer));
+    }
+  } guard;
+  GL.glReadBuffer(attachment == eGL_COLOR_ATTACHMENT0 ? eGL_COLOR_ATTACHMENT0 : eGL_NONE);
+  for(int layer = 0; layer < layers; ++layer)
+  {
+    if(layered)
+      GL.glFramebufferTextureLayer(eGL_READ_FRAMEBUFFER, attachment, GLuint(texture), level, layer);
+    else
+      GL.glFramebufferTexture2D(eGL_READ_FRAMEBUFFER, attachment, target, GLuint(texture), level);
+    Require(GL.glCheckFramebufferStatus(eGL_READ_FRAMEBUFFER) == eGL_FRAMEBUFFER_COMPLETE,
+            "snapshot raw texture format/subresource is not framebuffer-readable");
+    byte *destination = (byte *)pixels + size_t(sliceBytes * layer);
+    GL.glReadPixels(0, 0, width, height, narrowChannels ? eGL_RGBA : format, type,
+                    narrowChannels ? rgba.data() : destination);
+    replay_snapshot::CheckGL("direct raw texture readback (no shader conversion)");
+    if(narrowChannels)
+      for(size_t pixel = 0; pixel < size_t(width) * size_t(height); ++pixel)
+        memcpy(destination + pixel * narrowChannels, rgba.data() + pixel * 4, narrowChannels);
+  }
+}
+
+void ValidateGLSnapshotResource(GLResourceManager *manager, const GLResource &resource, ResourceId id)
+{
+  using namespace replay_snapshot;
+  if(manager != resolving)
+    return;
+  if(id == ResourceId())
+    Require(resource.name == 0, "snapshot references an unregistered nonzero GL object");
+  else
+  {
+    Require(manager->HasResource(id), "snapshot references a missing ResourceId");
+    Require(allowed && allowed->count(id), "snapshot references an object outside its inventory");
+  }
+}
+
+class GLReplaySnapshot
+{
+  using Bytes = replay_snapshot::Bytes;
+  using Writer = replay_snapshot::Writer;
+  using Reader = replay_snapshot::Reader;
+  using Resource = replay_snapshot::Resource;
+  static void Require(bool c, const char *m) { replay_snapshot::Require(c, m); }
+
+  struct Arena
+  {
+    GLResourceManager &manager;
+    decltype(GLResourceManager::m_InitialContents) original;
+    explicit Arena(GLResourceManager &m) : manager(m) { original.swap(manager.m_InitialContents); }
+    ~Arena()
+    {
+      for(auto &entry : manager.m_InitialContents)
+        entry.second.Free(&manager);
+      manager.m_InitialContents.clear();
+      original.swap(manager.m_InitialContents);
+    }
+  };
+  struct ResolveScope
+  {
+    ResolveScope(GLResourceManager &m, const std::set<ResourceId> &ids)
+    {
+      Require(!replay_snapshot::resolving, "nested snapshot operation");
+      replay_snapshot::resolving = &m; replay_snapshot::allowed = &ids;
+    }
+    ~ResolveScope() { replay_snapshot::resolving = NULL; replay_snapshot::allowed = NULL; }
+  };
+  struct StateGuard
+  {
+    WrappedOpenGL &driver;
+    GLRenderState state;
+    PixelPackState pack;
+    PixelUnpackState unpack;
+    bool active = true;
+    explicit StateGuard(WrappedOpenGL &d) : driver(d)
+    { state.FetchState(&driver); pack.Fetch(true); unpack.Fetch(true); }
+    ~StateGuard() { if(active) { state.ApplyState(&driver); pack.Apply(true); unpack.Apply(true); } }
+  };
+
+  static Bytes StreamBytes(WriteSerialiser &ser)
+  {
+    Require(!ser.IsErrored(), "snapshot serializer write failed");
+    uint64_t n = ser.GetWriter()->GetOffset();
+    Require(n <= replay_snapshot::MaxBlob, "snapshot resource exceeds v1 blob limit");
+    return Bytes(ser.GetWriter()->GetData(), ser.GetWriter()->GetData() + (size_t)n);
+  }
+  static void Setup(WriteSerialiser &ser, WrappedOpenGL &d)
+  { ser.SetUserData(d.GetResourceManager()); ser.SetVersion(d.m_SectionVersion); }
+  static void Setup(ReadSerialiser &ser, WrappedOpenGL &d)
+  { ser.SetUserData(d.GetResourceManager()); ser.SetVersion(d.m_SectionVersion); }
+  static void Finish(ReadSerialiser &ser, size_t length)
+  {
+    ser.EndChunk();
+    Require(!ser.IsErrored() && ser.GetReader()->GetOffset() == length,
+            "snapshot resource codec error or trailing data");
+  }
+
+  static uint64_t Boundary(WrappedOpenGL &d, uint32_t event)
+  {
+    Require(event && event < d.m_Events.size() && d.m_Events[event].eventId == event,
+            "snapshot boundary is not an exact API event");
+    auto &selected = d.m_Events[event];
+    uint64_t next = d.m_FrameReader->GetSize();
+    for(size_t i = size_t(event) + 1; i < d.m_Events.size(); ++i)
+    {
+      if(!d.m_Events[i].eventId) continue;
+      Require(d.m_Events[i].fileOffset != selected.fileOffset,
+              "snapshot boundary is inside a multi-action API chunk");
+      next = d.m_Events[i].fileOffset; break;
+    }
+    // Parse only immutable chunk headers. This scan does not call ProcessChunk,
+    // replay state setters, draws, dispatches, or copy commands.
+    uint64_t oldOffset = d.m_FrameReader->GetOffset();
+    struct RestoreOffset
+    {
+      StreamReader *reader; uint64_t offset;
+      ~RestoreOffset() { reader->SetOffset(offset); }
+    } restore{d.m_FrameReader, oldOffset};
+    d.m_FrameReader->SetOffset(0);
+    ReadSerialiser ser(d.m_FrameReader, Ownership::Nothing);
+    Setup(ser, d);
+    int groups = 0;
+    while(!ser.GetReader()->AtEnd())
+    {
+      uint64_t offset = ser.GetReader()->GetOffset();
+      GLChunk chunk = ser.ReadChunk<GLChunk>();
+      rdcstr name = WrappedOpenGL::GetChunkName(uint32_t(chunk));
+      if(offset < next)
+      {
+        if(name == "glPushDebugGroup") ++groups;
+        if(name == "glPopDebugGroup") --groups;
+        Require(groups >= 0, "capture has an unbalanced debug group before snapshot");
+      }
+      else
+      {
+        Require(!name.contains("GetQueryBufferObject") &&
+                    !name.contains("BeginConditionalRender") &&
+                    !name.contains("DrawTransformFeedback") && !name.contains("WaitSync"),
+                "snapshot v1 cannot restore query/TF/sync results consumed by the suffix");
+      }
+      // Persistent/external state has no exact initial-content codec in v1.
+      Require(!name.contains("ImportMemory") && !name.contains("ImportSemaphore") &&
+                  !name.contains("TextureStorageMem") && !name.contains("BufferStorageMem"),
+              "snapshot v1 does not support imported/external storage");
+      ser.SkipCurrentChunk(); ser.EndChunk();
+      Require(!ser.IsErrored(), "snapshot immutable chunk scan failed");
+    }
+    Require(groups == 0, "snapshot v1 refuses a captured debug group spanning its boundary");
+    return next;
+  }
+
+  static void Quiescent(WrappedOpenGL &d)
+  {
+    Require(IsReplayMode(d.m_State) && !d.m_FetchCounters, "snapshot needs ordinary GL replay");
+    Require(!d.m_ActiveConditional && !d.m_ActiveFeedback,
+            "snapshot v1 refuses active conditional rendering or transform feedback");
+    for(auto &queries : d.m_ActiveQueries)
+      for(bool active : queries)
+        Require(!active, "snapshot v1 refuses an active query");
+    Require(d.m_PersistentMaps.empty() && d.m_CoherentMaps.empty(),
+            "snapshot v1 refuses persistent/coherent mapped buffers");
+    Require(d.m_ImplicitThreadSwitches == 0, "snapshot v1 refuses multi-context capture execution");
+    replay_snapshot::CheckGL("entry (pre-existing errors are not discarded)");
+    GL.glFinish();
+    replay_snapshot::CheckGL("synchronous completion");
+  }
+
+  static std::set<ResourceId> Inventory(GLReplay &r)
+  {
+    auto &d = *r.m_pDriver;
+    auto &m = *d.GetResourceManager();
+    std::set<ResourceId> ids;
+    for(auto &description : r.m_Resources)
+      if(m.HasResource(description.resourceId))
+        ids.insert(description.resourceId);
+    // Synthetic default VAO/backbuffer objects are persistent replay state too.
+    const GLResource special[] = {VertexArrayRes(d.GetCtx(), d.m_Global_VAO0),
+      FramebufferRes(d.GetCtx(), d.m_Global_FBO0),
+      FramebufferRes(d.GetCtx(), d.m_CurrentDefaultFBO)};
+    for(auto resource : special)
+      if(m.GetResID(resource) != ResourceId()) ids.insert(m.GetResID(resource));
+    Require(ids.size() <= replay_snapshot::MaxObjects, "snapshot object-count limit");
+    // Special RenderDoc descriptors are not actual mutable GL objects.
+    for(auto it = ids.begin(); it != ids.end();)
+    {
+      auto object = m.GetResource(*it);
+      if(object.Namespace == eResSpecial)
+        it = ids.erase(it);
+      else
+        ++it;
+    }
+    return ids;
+  }
+
+  static Bytes Signature(WrappedOpenGL &d, ResourceId id)
+  {
+    auto &m = *d.GetResourceManager();
+    GLResource res = m.GetResource(id);
+    auto &ctx = d.GetCtx();
+    Require(res.ContextShareGroup == ctx.ctx || res.ContextShareGroup == ctx.shareGroup,
+            "snapshot v1 resource belongs to another context/sharegroup");
+    Writer out; out.U64(uint32_t(res.Namespace));
+    switch(res.Namespace)
+    {
+      case eResBuffer:
+      {
+        GLint size = 0;
+        GL.glGetNamedBufferParameterivEXT(res.name, eGL_BUFFER_SIZE, &size);
+        GLint mapped = 0;
+        GL.glGetNamedBufferParameterivEXT(res.name, eGL_BUFFER_MAPPED, &mapped);
+        Require(!mapped, "snapshot v1 refuses a mapped buffer");
+        Require(size >= 0 && uint64_t(size) <= replay_snapshot::MaxBlob,
+                "snapshot v1 buffer allocation size limit");
+        out.U64(uint64_t(size));
+        const auto &data = d.m_Buffers.at(id);
+        out.U64(data.size); out.U64(uint32_t(data.curType));
+        break;
+      }
+      case eResTexture:
+      {
+        const auto &t = d.m_Textures.at(id);
+        Require(!t.view && !t.emulated, "snapshot v1 refuses texture views/emulated formats");
+        Require(t.samples <= 1, "snapshot v1 refuses multisample texture storage");
+        Require(t.curType == eGL_TEXTURE_2D || t.curType == eGL_TEXTURE_3D ||
+                    t.curType == eGL_TEXTURE_2D_ARRAY || t.curType == eGL_TEXTURE_CUBE_MAP ||
+                    t.curType == eGL_TEXTURE_CUBE_MAP_ARRAY || t.curType == eGL_TEXTURE_BUFFER,
+                "snapshot v1 texture target has no validated codec");
+        Require(t.internalFormat != eGL_NONE && t.width > 0 && t.height > 0 && t.depth > 0,
+                "snapshot v1 refuses unallocated/incomplete texture storage");
+        Require(t.width <= 32768 && t.height <= 32768 && t.depth <= 2048,
+                "snapshot texture extent limit");
+        out.U64(uint32_t(t.curType)); out.U64(uint32_t(t.internalFormat));
+        out.U64(uint32_t(t.width)); out.U64(uint32_t(t.height)); out.U64(uint32_t(t.depth));
+        out.U64(uint32_t(t.samples)); out.U64(uint32_t(t.dimension));
+        out.U64(uint32_t(t.initFormatHint)); out.U64(uint32_t(t.initTypeHint));
+        out.U64(t.mipsValid);
+        int mips = t.curType == eGL_TEXTURE_BUFFER ? 1 :
+                   GetGLReplaySnapshotMipCount(t.curType, res.name);
+        Require(mips > 0 && mips <= 16, "snapshot invalid mip count");
+        out.U64(uint32_t(mips));
+        // Query each physical subresource; metadata-only dimension matching is insufficient.
+        if(t.curType != eGL_TEXTURE_BUFFER)
+          for(int face = 0; face < (t.curType == eGL_TEXTURE_CUBE_MAP ? 6 : 1); ++face)
+            for(int mip = 0; mip < mips; ++mip)
+            {
+              GLenum target = t.curType == eGL_TEXTURE_CUBE_MAP ?
+                  GLenum(eGL_TEXTURE_CUBE_MAP_POSITIVE_X + face) : t.curType;
+              for(GLenum parameter : {eGL_TEXTURE_WIDTH, eGL_TEXTURE_HEIGHT, eGL_TEXTURE_DEPTH,
+                                       eGL_TEXTURE_INTERNAL_FORMAT})
+              {
+                GLint value = 0;
+                GL.glGetTextureLevelParameterivEXT(res.name, target, mip, parameter, &value);
+                out.U64(uint32_t(value));
+              }
+            }
+        break;
+      }
+      case eResProgram:
+      {
+        const auto &p = d.m_Programs.at(id);
+        Require(p.linked, "snapshot v1 refuses an unlinked program");
+        out.U64(p.shaderProgramUnlinkable);
+        for(ResourceId shader : p.stageShaders) out.U64(replay_snapshot::ID(shader));
+        break;
+      }
+      case eResShader:
+      {
+        const auto &s = d.m_Shaders.at(id);
+        out.U64(uint32_t(s.type));
+        out.U64(s.sources.size());
+        for(const auto &source : s.sources) out.String(source);
+        out.U64(s.spirvWords.size());
+        for(uint32_t word : s.spirvWords) out.U64(word);
+        out.String(s.entryPoint);
+        out.U64(s.specIDs.size());
+        for(uint32_t value : s.specIDs) out.U64(value);
+        for(uint32_t value : s.specValues) out.U64(value);
+        break;
+      }
+      case eResProgramPipe:
+      {
+        auto pipeline = d.m_Pipelines.find(id);
+        for(size_t stage = 0; stage < NumShaderStages; ++stage)
+        {
+          out.U64(pipeline == d.m_Pipelines.end() ? 0 : replay_snapshot::ID(pipeline->second.stagePrograms[stage]));
+          out.U64(pipeline == d.m_Pipelines.end() ? 0 : replay_snapshot::ID(pipeline->second.stageShaders[stage]));
+        }
+        break;
+      }
+      case eResFramebuffer: case eResSampler: case eResVertexArray:
+      case eResFeedback: case eResQuery:
+        break;
+      default:
+        throw std::runtime_error(std::string("snapshot v1 unsupported resource namespace: ") +
+                                 std::to_string(unsigned(res.Namespace)));
+    }
+    replay_snapshot::CheckGL("inventory/storage validation");
+    return out.bytes;
+  }
+
+  static Bytes State(WrappedOpenGL &d, GLRenderState &state)
+  {
+    WriteSerialiser ser(new StreamWriter(4096), Ownership::Stream); Setup(ser, d);
+    ser.BeginChunk(uint32_t(SystemChunk::CaptureBegin), 0);
+    ser.Serialise("state"_lit, state);
+    ser.EndChunk(); return StreamBytes(ser);
+  }
+  static void DecodeState(WrappedOpenGL &d, const Bytes &blob, GLRenderState &state)
+  {
+    SafetyDecodeState(d, blob, state);
+  }
+  static void Pack(Writer &w, const PixelStorageState &p)
+  {
+    for(int32_t value : {p.swapBytes,p.lsbFirst,p.rowlength,p.imageheight,p.skipPixels,p.skipRows,
+         p.skipImages,p.alignment,p.compressedBlockWidth,p.compressedBlockHeight,
+         p.compressedBlockDepth,p.compressedBlockSize}) w.U64(uint32_t(value));
+  }
+  static void Pack(Reader &r, PixelStorageState &p)
+  {
+    for(int32_t *value : {&p.swapBytes,&p.lsbFirst,&p.rowlength,&p.imageheight,&p.skipPixels,
+         &p.skipRows,&p.skipImages,&p.alignment,&p.compressedBlockWidth,&p.compressedBlockHeight,
+         &p.compressedBlockDepth,&p.compressedBlockSize})
+    {
+      uint64_t raw = r.U64(); Require(raw <= UINT32_MAX, "snapshot invalid pixel-store value");
+      *value = int32_t(uint32_t(raw));
+    }
+    Require(p.alignment == 1 || p.alignment == 2 || p.alignment == 4 || p.alignment == 8,
+            "snapshot invalid pixel-store alignment");
+  }
+
+  static Bytes CaptureResource(WrappedOpenGL &d, ResourceId id)
+  {
+    auto &m = *d.GetResourceManager();
+    GLResource res = m.GetResource(id);
+    if(res.Namespace == eResShader || res.Namespace == eResQuery) return {};
+    GLint originalMaxLevel = 0;
+    if(res.Namespace == eResTexture && d.m_Textures[id].curType != eGL_TEXTURE_BUFFER)
+      GL.glGetTextureParameterivEXT(res.name, d.m_Textures[id].curType, eGL_TEXTURE_MAX_LEVEL, &originalMaxLevel);
+    if(res.Namespace == eResProgram)
+    {
+      WriteSerialiser ser(new StreamWriter(4096), Ownership::Stream); Setup(ser, d);
+      ser.BeginChunk(uint32_t(SystemChunk::InitialContents), 0);
+      ser.Serialise("id"_lit, id); ser.Serialise("Type"_lit, res.Namespace);
+      PerStageReflections stages; d.FillReflectionArray(id, stages);
+      SerialiseProgramBindings(ser, CaptureState::ActiveCapturing, stages, res.name);
+      SerialiseProgramUniforms(ser, CaptureState::ActiveCapturing, stages, res.name, NULL);
+      ser.EndChunk(); replay_snapshot::CheckGL("program serialization");
+      return StreamBytes(ser);
+    }
+    // Avoid the capture-only persistent-context overload (replay resources have no records).
+    m.ContextPrepare_InitialState(res);
+    replay_snapshot::CheckGL("resource preparation");
+    if(res.Namespace == eResTexture && d.m_Textures[id].curType != eGL_TEXTURE_BUFFER)
+    {
+      GLint after = 0;
+      GL.glGetTextureParameterivEXT(res.name, d.m_Textures[id].curType, eGL_TEXTURE_MAX_LEVEL, &after);
+      if(after != originalMaxLevel)
+        throw std::runtime_error(std::string("snapshot preparation changed texture max-level: ") +
+              std::to_string(replay_snapshot::ID(id)) + " before=" + std::to_string(originalMaxLevel) +
+              " after=" + std::to_string(after));
+    }
+    auto it = m.m_InitialContents.find(id);
+    Require(it != m.m_InitialContents.end(), "snapshot resource preparation produced no contents");
+    WriteSerialiser ser(new StreamWriter(4096), Ownership::Stream); Setup(ser, d);
+    if(it->second.chunk)
+      it->second.chunk->Write(ser);
+    else
+    {
+      auto initial = it->second.data;
+      initial.type = res.Namespace;
+      if(res.Namespace == eResFramebuffer) Require(initial.fbo.valid, "snapshot invalid FBO state");
+      if(res.Namespace == eResVertexArray) Require(initial.vao.valid, "snapshot invalid VAO state");
+      if(res.Namespace == eResSampler) Require(initial.samp.valid, "snapshot invalid sampler state");
+      if(res.Namespace == eResFeedback) Require(initial.xfb.valid, "snapshot invalid TF binding state");
+      if(res.Namespace == eResProgramPipe) Require(initial.pipe.valid, "snapshot invalid pipeline state");
+      ser.BeginChunk(uint32_t(SystemChunk::InitialContents), 0);
+      m.Serialise_InitialState<WriteSerialiser>(ser, id, NULL, &initial);
+      ser.EndChunk();
+    }
+    replay_snapshot::CheckGL("resource serialization");
+    return StreamBytes(ser);
+  }
+
+  #include "gl_snapshot_codec_safety.inl"
+
+  static void RestoreResource(WrappedOpenGL &d, const Resource &record)
+  {
+    if(record.type == eResShader || record.type == eResQuery)
+    { Require(record.blob.empty(), "snapshot unexpected immutable/query contents"); return; }
+    Require(!record.blob.empty(), "snapshot missing resource contents");
+    auto &m = *d.GetResourceManager();
+    // Check the embedded identity/type before any codec is permitted to touch GL.
+    ReadSerialiser inspect(new StreamReader(record.blob.data(), record.blob.size()), Ownership::Stream);
+    Setup(inspect, d);
+    Require(inspect.ReadChunk<SystemChunk>() == SystemChunk::InitialContents,
+            "snapshot resource chunk type mismatch");
+    ResourceId id; GLNamespace type;
+    GLint expectedMaxLevel = -1;
+    inspect.Serialise("id"_lit, id); inspect.Serialise("Type"_lit, type);
+    Require(!inspect.IsErrored() && id == record.id && type == record.type,
+            "snapshot resource embedded identity mismatch");
+    if(type == eResProgram)
+    {
+      // Parse and validate all variable-length program metadata without GL side effects first.
+      SemanticProgram(d, id, record.blob);
+      PerStageReflections stages; d.FillReflectionArray(id, stages);
+      GLuint program = m.GetResource(id).name;
+      bool changed = SerialiseProgramBindings(inspect, CaptureState::ActiveReplaying, stages, program);
+      if(changed)
+      {
+        Require(!d.m_Programs[id].shaderProgramUnlinkable,
+                "snapshot needs to relink an unlinkable program");
+        GL.glLinkProgram(program);
+        GLint linked = 0; GL.glGetProgramiv(program, eGL_LINK_STATUS, &linked);
+        Require(linked != 0, "snapshot program re-link failed");
+      }
+      std::map<GLint, GLint> savedToNew;
+      SerialiseProgramUniforms(inspect, CaptureState::ActiveReplaying, stages, program, &savedToNew);
+      Finish(inspect, record.blob.size());
+      std::map<GLint, GLint> composed;
+      for(const auto &location : record.locations)
+      {
+        if(location.second < 0) composed[location.first] = -1;
+        else
+        {
+          auto found = savedToNew.find(location.second);
+          Require(found != savedToNew.end(), "snapshot uniform location composition is incomplete");
+          composed[location.first] = found->second;
+        }
+      }
+      d.m_Programs[id].locationTranslate.swap(composed);
+      replay_snapshot::CheckGL("program bindings/uniform restoration");
+      return;
+    }
+    if(type == eResBuffer)
+    {
+      uint32_t bytes = 0; inspect.Serialise("BufferContentsSize"_lit, bytes);
+      Reader signature(record.signature); signature.U64();
+      Require(bytes == signature.U64() && bytes <= replay_snapshot::MaxBlob,
+              "snapshot buffer content size mismatch");
+      InspectRawBytes(inspect, bytes, record.blob.size());
+      Finish(inspect, record.blob.size());
+    }
+    else if(type == eResTexture)
+    {
+      TextureStateInitialData texture;
+      inspect.Serialise("TextureState"_lit, texture);
+      expectedMaxLevel = texture.maxLevel;
+      const auto &original = d.m_Textures.at(id);
+      Require(!inspect.IsErrored() && !texture.isView && texture.samples <= 1 &&
+                  texture.type == original.curType && texture.internalformat == original.internalFormat &&
+                  texture.width == uint32_t(original.width) && texture.height == uint32_t(original.height) &&
+                  texture.depth == uint32_t(original.depth) && texture.mips > 0 && texture.mips <= 16,
+              "snapshot texture embedded storage mismatch");
+      if(texture.type != eGL_TEXTURE_BUFFER)
+      {
+        Require(texture.dim == uint32_t(original.dimension), "snapshot texture dimension mismatch");
+        bool compressed = IsCompressedFormat(texture.internalformat);
+        for(int mip = 0; mip < texture.mips; ++mip)
+        {
+          uint32_t w = RDCMAX(1U, texture.width >> mip);
+          uint32_t h = RDCMAX(1U, texture.height >> mip);
+          uint32_t depth = RDCMAX(1U, texture.depth >> mip);
+          if(texture.type == eGL_TEXTURE_2D_ARRAY || texture.type == eGL_TEXTURE_CUBE_MAP_ARRAY)
+            depth = texture.depth;
+          uint64_t bytes = compressed ? GetCompressedByteSize(w, h, depth, texture.internalformat) :
+              GetByteSize(w, h, depth, GetBaseFormat(texture.internalformat), GetDataType(texture.internalformat));
+          Require(bytes && bytes <= record.blob.size(), "snapshot texture subresource byte limit");
+          for(int face = 0; face < (texture.type == eGL_TEXTURE_CUBE_MAP ? 6 : 1); ++face)
+            InspectRawBytes(inspect, bytes, record.blob.size());
+        }
+      }
+      Finish(inspect, record.blob.size());
+    }
+    ReadSerialiser ser(new StreamReader(record.blob.data(), record.blob.size()), Ownership::Stream);
+    Setup(ser, d); ser.ReadChunk<SystemChunk>();
+    GLInitialContents empty;
+    m.Serialise_InitialState<ReadSerialiser>(ser, id, NULL, &empty);
+    Finish(ser, record.blob.size());
+    auto found = m.m_InitialContents.find(id);
+    Require(found != m.m_InitialContents.end(), "snapshot codec produced no restored resource");
+    m.Apply_InitialState(m.GetResource(id), found->second.data);
+    if(type == eResTexture && d.m_Textures[id].curType != eGL_TEXTURE_BUFFER)
+    {
+      GLint after = 0;
+      GL.glGetTextureParameterivEXT(m.GetResource(id).name, d.m_Textures[id].curType, eGL_TEXTURE_MAX_LEVEL, &after);
+      if(after != expectedMaxLevel)
+        throw std::runtime_error(std::string("snapshot texture max-level apply mismatch: ") +
+            std::to_string(replay_snapshot::ID(id)) + " expected=" + std::to_string(expectedMaxLevel) +
+            " actual=" + std::to_string(after) + " stored=" + std::to_string(found->second.data.tex.maxLevel));
+    }
+    replay_snapshot::CheckGL("resource restore");
+  }
+
+  static void InspectRawBytes(ReadSerialiser &ser, uint64_t expected, size_t length)
+  {
+    // NoFlags pointer arrays encode a SECOND uint64 byte count. The ordinary
+    // RenderDoc reader does not know the caller's mapped-buffer/scratch capacity.
+    // Verify that count and the exact aligned physical extent before invoking it.
+    uint64_t bytes = 0; ser.Serialise("encoded_byte_count"_lit, bytes);
+    Require(!ser.IsErrored() && bytes == expected, "snapshot embedded raw byte count/capacity mismatch");
+    ser.GetReader()->AlignTo<64>();
+    uint64_t offset = ser.GetReader()->GetOffset();
+    Require(offset <= length && bytes <= length - offset, "snapshot raw byte span exceeds its blob");
+    ser.GetReader()->SetOffset(offset + bytes);
+  }
+
+  static void CanonicalProgramObject(Writer &writer, const SDObject &object)
+  {
+    // Numeric GL uniform locations are process-local. Everything else (names,
+    // typed values, array order, resource/block bindings) is semantic state.
+    if(object.name == "Location") return;
+    if(object.name == "Binding")
+      Require(object.data.basic.i >= -1 && object.data.basic.i < 64,
+              "snapshot program binding is outside the codec's bitmask width");
+    writer.String(object.name); writer.String(object.type.name);
+    writer.U64(uint64_t(object.type.basetype)); writer.U64(object.type.byteSize);
+    writer.String(object.data.str); writer.U64(object.data.basic.u);
+    uint64_t count = 0;
+    for(size_t i = 0; i < object.NumChildren(); ++i)
+      if(object.GetChild(i)->name != "Location") ++count;
+    writer.U64(count);
+    for(size_t i = 0; i < object.NumChildren(); ++i)
+      CanonicalProgramObject(writer, *object.GetChild(i));
+  }
+  static Bytes SemanticProgram(WrappedOpenGL &d, ResourceId resource, const Bytes &blob)
+  {
+    ReadSerialiser ser(new StreamReader(blob.data(), blob.size()), Ownership::Stream);
+    Setup(ser, d); ser.ConfigureStructuredExport(&WrappedOpenGL::GetChunkName, false, 0, 1.0);
+    Require(ser.ReadChunk<SystemChunk>() == SystemChunk::InitialContents, "snapshot program chunk mismatch");
+    ResourceId id; GLNamespace type;
+    ser.Serialise("id"_lit, id); ser.Serialise("Type"_lit, type);
+    Require(id == resource && type == eResProgram, "snapshot program identity mismatch");
+    PerStageReflections stages; d.FillReflectionArray(id, stages);
+    SerialiseProgramBindings(ser, CaptureState::StructuredExport, stages, 0);
+    SerialiseProgramUniforms(ser, CaptureState::StructuredExport, stages, 0, NULL);
+    Finish(ser, blob.size());
+    Require(ser.GetStructuredFile().chunks.size() == 1, "snapshot program structured codec mismatch");
+    Writer out;
+    CanonicalProgramObject(out, *ser.GetStructuredFile().chunks[0]);
+    return out.bytes;
+  }
+  static void VerifyRestored(WrappedOpenGL &d, const std::vector<Resource> &records,
+                             const Bytes &stateBlob, const PixelPackState &pack,
+                             const PixelUnpackState &unpack)
+  {
+    StateGuard actual(d);
+    Require(State(d, actual.state) == stateBlob, "snapshot restored GL context state differs");
+    Writer expectedPixel, actualPixel;
+    Pack(expectedPixel, pack); Pack(expectedPixel, unpack);
+    Pack(actualPixel, actual.pack); Pack(actualPixel, actual.unpack);
+    Require(expectedPixel.bytes == actualPixel.bytes, "snapshot restored pixel-store state differs");
+    Arena verify(*d.GetResourceManager());
+    for(const auto &record : records)
+    {
+      Require(Signature(d, record.id) == record.signature, "snapshot restored storage signature differs");
+      Bytes bytes = CaptureResource(d, record.id);
+      bool equal = record.type == eResProgram ?
+          SemanticProgram(d, record.id, bytes) == SemanticProgram(d, record.id, record.blob) :
+          bytes == record.blob;
+      if(!equal)
+      {
+        size_t offset = 0;
+        while(offset < bytes.size() && offset < record.blob.size() && bytes[offset] == record.blob[offset]) ++offset;
+        throw std::runtime_error(std::string("snapshot restored resource contents/state differs: ") +
+             std::to_string(replay_snapshot::ID(record.id)) + " first_byte=" + std::to_string(offset) +
+             " expected_size=" + std::to_string(record.blob.size()) + " actual_size=" + std::to_string(bytes.size()) +
+             " expected=" + std::to_string(offset < record.blob.size() ? record.blob[offset] : 999) +
+             " actual=" + std::to_string(offset < bytes.size() ? bytes[offset] : 999));
+      }
+    }
+    replay_snapshot::CheckGL("full resource/context read-back verification");
+  }
+
+  static void RestoreCPUState(WrappedOpenGL &d, const GLRenderState &state)
+  {
+    auto &m = *d.GetResourceManager();
+    auto &context = d.GetCtxData();
+    context.m_Program = state.Program.name;
+    context.m_ProgramPipeline = state.Pipeline.name;
+    context.m_TextureUnit = int(state.ActiveTexture - eGL_TEXTURE0);
+    context.m_VertexArrayRecord = m.GetResourceRecord(state.VAO);
+    context.m_FeedbackRecord = m.GetResourceRecord(state.FeedbackObj);
+    context.m_DrawFramebufferRecord = m.GetResourceRecord(state.DrawFBO);
+    context.m_ReadFramebufferRecord = m.GetResourceRecord(state.ReadFBO);
+    // Replay serialisers use real GL bindings; never retain capture-process record pointers.
+    for(auto &record : context.m_BufferRecord) record = NULL;
+    for(auto &binding : m.m_FBOAttachmentsCache) delete binding.second;
+    m.m_FBOAttachmentsCache.clear();
+  }
+
+public:
+  static void Save(GLReplay &replay, uint32_t event, const char *path, const char *capture)
+  {
+    replay_snapshot::CheckCapture(capture);
+    Require(!replay.m_Proxy, "snapshot v1 refuses proxy replay devices");
+    replay.MakeCurrentReplayContext(&replay.m_ReplayCtx);
+    auto &d = *replay.m_pDriver;
+    Quiescent(d);
+    uint64_t next = Boundary(d, event);
+    auto ids = Inventory(replay);
+    StateGuard saved(d);
+    replay_snapshot::CheckGL("context-state fetch");
+    ResolveScope resolving(*d.GetResourceManager(), ids);
+    std::vector<Resource> records;
+    // Validate every object before allocating snapshots or publishing anything.
+    for(ResourceId id : ids)
+    {
+      Resource record; record.id = id;
+      record.type = d.GetResourceManager()->GetResource(id).Namespace;
+      try { record.signature = Signature(d, id); }
+      catch(const std::exception &error)
+      { throw std::runtime_error(std::string("resource ") + std::to_string(replay_snapshot::ID(id)) +
+                                 " namespace " + std::to_string(unsigned(record.type)) + ": " + error.what()); }
+      if(record.type == eResProgram) record.locations = d.m_Programs.at(id).locationTranslate;
+      records.push_back(std::move(record));
+    }
+    Bytes state = State(d, saved.state);
+    {
+      Arena arena(*d.GetResourceManager());
+      for(auto &record : records)
+      {
+        try { record.blob = CaptureResource(d, record.id); }
+        catch(const std::exception &error)
+        { throw std::runtime_error(std::string("snapshot capture resource ") +
+              std::to_string(replay_snapshot::ID(record.id)) + ": " + error.what()); }
+      }
+    }
+    Writer out;
+    out.String(capture); out.U64(d.m_SectionVersion); out.U64(event); out.U64(next);
+    out.String((const char *)GL.glGetString(eGL_VENDOR));
+    out.String((const char *)GL.glGetString(eGL_RENDERER));
+    out.String((const char *)GL.glGetString(eGL_VERSION));
+    out.Blob(state); Pack(out, saved.pack); Pack(out, saved.unpack);
+    out.U64(replay_snapshot::ID(d.GetResourceManager()->GetResID(
+        FramebufferRes(d.GetCtx(), d.m_CurrentDefaultFBO))));
+    out.U64(records.size());
+    for(const auto &record : records)
+    {
+      out.U64(replay_snapshot::ID(record.id)); out.U64(uint32_t(record.type));
+      out.Blob(record.signature); out.U64(record.locations.size());
+      for(const auto &location : record.locations)
+      { out.U64(uint32_t(location.first)); out.U64(uint32_t(location.second)); }
+      out.Blob(record.blob);
+    }
+    // Restore before publishing: a failed restoration must not yield a usable checkpoint.
+    saved.state.ApplyState(&d); saved.pack.Apply(true); saved.unpack.Apply(true);
+    replay_snapshot::CheckGL("save state restoration");
+    saved.active = false;
+    VerifyRestored(d, records, state, saved.pack, saved.unpack);
+    replay_snapshot::Publish(path, out.bytes);
+  }
+
+  static void Load(GLReplay &replay, const char *path, const char *capture, uint32_t &event)
+  {
+    replay_snapshot::CheckCapture(capture);
+    Bytes payload = replay_snapshot::ReadArchive(path);
+    Reader in(payload);
+    Require(in.String(64) == capture, "snapshot capture SHA-256 mismatch");
+    auto &d = *replay.m_pDriver;
+    Require(in.U64() == d.m_SectionVersion, "snapshot RenderDoc section version mismatch");
+    uint64_t restoredEvent = in.U64(), next = in.U64();
+    Require(restoredEvent && restoredEvent <= UINT32_MAX, "snapshot event outside range");
+    Require(!replay.m_Proxy, "snapshot v1 refuses proxy replay devices");
+    replay.MakeCurrentReplayContext(&replay.m_ReplayCtx);
+    Quiescent(d);
+    Require(Boundary(d, uint32_t(restoredEvent)) == next, "snapshot event/chunk boundary mismatch");
+    Require(in.String() == (const char *)GL.glGetString(eGL_VENDOR) &&
+                in.String() == (const char *)GL.glGetString(eGL_RENDERER) &&
+                in.String() == (const char *)GL.glGetString(eGL_VERSION),
+            "snapshot GL implementation signature mismatch");
+    Bytes stateBlob = in.Blob(65536);
+    PixelPackState pack; PixelUnpackState unpack;
+    Pack(in, pack); Pack(in, unpack);
+    ResourceId defaultFBO = replay_snapshot::ID(in.U64());
+    auto ids = Inventory(replay);
+    uint64_t count = in.U64();
+    Require(count == ids.size() && count <= replay_snapshot::MaxObjects, "snapshot inventory count mismatch");
+    std::vector<Resource> records;
+    std::set<ResourceId> seen;
+    for(uint64_t i = 0; i < count; ++i)
+    {
+      Resource record; record.id = replay_snapshot::ID(in.U64());
+      uint64_t type = in.U64();
+      Require(type <= UINT32_MAX && ids.count(record.id) && seen.insert(record.id).second,
+              "snapshot missing, duplicate, or foreign resource identity");
+      record.type = GLNamespace(type);
+      Require(d.GetResourceManager()->GetResource(record.id).Namespace == record.type,
+              "snapshot resource namespace mismatch");
+      record.signature = in.Blob(8 * 1024 * 1024);
+      Require(record.signature == Signature(d, record.id),
+              "snapshot boundary storage/program signature differs from fresh controller (v1 unsupported)");
+      uint64_t locations = in.U64();
+      Require(locations <= 65536 && (record.type == eResProgram || locations == 0),
+              "snapshot uniform-map count invalid");
+      for(uint64_t j = 0; j < locations; ++j)
+      {
+        uint64_t from = in.U64(), to = in.U64();
+        Require(from <= UINT32_MAX && to <= UINT32_MAX &&
+                    record.locations.emplace(GLint(uint32_t(from)), GLint(uint32_t(to))).second,
+                "snapshot invalid or duplicate uniform mapping");
+      }
+      record.blob = in.Blob(record.type == eResProgram ? 1024 * 1024 : replay_snapshot::MaxBlob);
+      records.push_back(std::move(record));
+    }
+    in.Done();
+    Require(defaultFBO == ResourceId() || ids.count(defaultFBO), "snapshot default FBO missing");
+    Require(defaultFBO == ResourceId() ||
+                d.GetResourceManager()->GetResource(defaultFBO).Namespace == eResFramebuffer,
+            "snapshot default FBO reference has the wrong namespace");
+    ResolveScope resolving(*d.GetResourceManager(), ids);
+    GLRenderState state;
+    DecodeState(d, stateBlob, state);
+    // Validate every nested wire length and typed reference before ANY live
+    // resource is written. Per-resource validation during restore is too late.
+    for(const auto &record : records) SafetyPreflightResource(d, record);
+    // Codec reads append display-only resource init chunk indices. Preserve the immutable catalog.
+    auto descriptions = replay.m_Resources;
+    struct DescriptionGuard
+    {
+      GLReplay &replay; decltype(GLReplay::m_Resources) &original;
+      ~DescriptionGuard() { replay.m_Resources.swap(original); }
+    } descriptionsGuard{replay, descriptions};
+    {
+      Arena arena(*d.GetResourceManager());
+      // Data/storage first; FBO/VAO/pipeline bindings last, preserving original ResourceIds.
+      for(int pass = 0; pass < 2; ++pass)
+        for(const auto &record : records)
+        {
+          bool binding = record.type == eResFramebuffer || record.type == eResVertexArray ||
+                         record.type == eResProgramPipe || record.type == eResFeedback;
+          if(binding == bool(pass)) RestoreResource(d, record);
+        }
+    }
+    if(defaultFBO != ResourceId())
+      d.m_CurrentDefaultFBO = d.GetResourceManager()->GetResource(defaultFBO).name;
+    state.ApplyState(&d); pack.Apply(true); unpack.Apply(true);
+    RestoreCPUState(d, state);
+    GL.glFinish(); replay_snapshot::CheckGL("restored resource completion");
+    VerifyRestored(d, records, stateBlob, pack, unpack);
+    d.m_CurEvents.clear();
+    d.m_CurEventID = uint32_t(restoredEvent) + 1;
+    d.m_FirstEventID = uint32_t(restoredEvent) + 1;
+    d.m_LastEventID = uint32_t(restoredEvent);
+    d.m_ReplayEventCount = 0; d.m_WasActiveFeedback = false;
+    d.m_FrameReader->SetOffset(next);
+    for(auto &cached : replay.m_GetTexturePrevData) { delete[] cached; cached = NULL; }
+    GL.glFinish(); replay_snapshot::CheckGL("completed restore");
+    event = uint32_t(restoredEvent);
+  }
+};
+
+void RegisterGLSnapshotDriver(GLReplay *driver)
+{ replay_snapshot::drivers[driver] = driver; }
+void UnregisterGLSnapshotDriver(GLReplay *driver)
+{ replay_snapshot::drivers.erase(driver); }
+
+rdcstr SaveGLReplaySnapshot(IReplayDriver *driver, uint32_t event, const char *path, const char *capture)
+{
+  auto found = replay_snapshot::drivers.find(driver);
+  if(found == replay_snapshot::drivers.end()) return "snapshot requires a live local OpenGL device";
+  try { GLReplaySnapshot::Save(*found->second, event, path, capture); return {}; }
+  catch(const std::exception &e) { return rdcstr("snapshot save refused: ") + e.what(); }
+  catch(...) { return "snapshot save failed with an unknown exception"; }
+}
+rdcstr LoadGLReplaySnapshot(IReplayDriver *driver, const char *path, const char *capture, uint32_t &event)
+{
+  auto found = replay_snapshot::drivers.find(driver);
+  if(found == replay_snapshot::drivers.end()) return "snapshot requires a live local OpenGL device";
+  try { GLReplaySnapshot::Load(*found->second, path, capture, event); return {}; }
+  catch(const std::exception &e) { return rdcstr("snapshot load refused: ") + e.what(); }
+  catch(...) { return "snapshot load failed with an unknown exception"; }
+}
