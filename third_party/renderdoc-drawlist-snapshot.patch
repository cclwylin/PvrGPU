diff --git a/renderdoc/driver/gl/gl_snapshot_codec_safety.inl b/renderdoc/driver/gl/gl_snapshot_codec_safety.inl
new file mode 100644
--- /dev/null
+++ b/renderdoc/driver/gl/gl_snapshot_codec_safety.inl
@@ -0,0 +1,357 @@
+// Included inside GLReplaySnapshot. No GL calls or changes to the upstream
+// serializer. Untrusted archive fields are checked before ordinary GL codecs.
+// Fixed-array structured reads visit only N elements (plus at most one dummy);
+// canonical re-encoding rejects their permissive count conversion. Pointer
+// arrays require a separate capacity preflight even in structured-export mode.
+
+static void SafetyStructured(ReadSerialiser &ser, WrappedOpenGL &d)
+{
+  Setup(ser, d);
+  ser.ConfigureStructuredExport(&WrappedOpenGL::GetChunkName, false, 0, 1.0);
+}
+
+static void SafetyTyped(WrappedOpenGL &d, const GLResource &resource, GLNamespace type)
+{
+  const auto id = d.GetResourceManager()->GetResID(resource);
+  const bool null = resource.name == 0 && id == ResourceId();
+  Require(null || (id != ResourceId() && resource.Namespace == type),
+          "snapshot typed resource reference has the wrong namespace");
+}
+
+static void SafetyDecodeState(WrappedOpenGL &d, const Bytes &blob, GLRenderState &state)
+{
+  Require(blob.size() <= 65536, "snapshot GL state blob limit");
+  ReadSerialiser ser(new StreamReader(blob.data(), blob.size()), Ownership::Stream);
+  SafetyStructured(ser, d);
+  Require(ser.ReadChunk<SystemChunk>() == SystemChunk::CaptureBegin,
+          "snapshot GL state chunk mismatch");
+  ser.Serialise("state"_lit, state);
+  Finish(ser, blob.size());
+  Require(state.ContextPresent, "snapshot context state is absent");
+  // Besides exact fixed counts this rejects truncated/defaulted arrays,
+  // alternate headers and noncanonical padding before anything reaches GL.
+  Require(State(d, state) == blob, "snapshot GL state encoding/counts are not canonical");
+  for(const auto *array : {state.Tex1D,state.Tex2D,state.Tex3D,state.Tex1DArray,state.Tex2DArray,
+                          state.TexCubeArray,state.TexRect,state.TexBuffer,state.TexCube,
+                          state.Tex2DMS,state.Tex2DMSArray})
+    for(size_t i = 0; i < 128; ++i) SafetyTyped(d, array[i], eResTexture);
+  for(auto resource : state.Samplers) SafetyTyped(d, resource, eResSampler);
+  for(auto image : state.Images) SafetyTyped(d, image.res, eResTexture);
+  for(auto resource : state.BufferBindings) SafetyTyped(d, resource, eResBuffer);
+  for(auto binding : state.AtomicCounter) SafetyTyped(d, binding.res, eResBuffer);
+  for(auto binding : state.ShaderStorage) SafetyTyped(d, binding.res, eResBuffer);
+  for(auto binding : state.TransformFeedback) SafetyTyped(d, binding.res, eResBuffer);
+  for(auto binding : state.UniformBinding) SafetyTyped(d, binding.res, eResBuffer);
+  SafetyTyped(d, state.Program, eResProgram);
+  SafetyTyped(d, state.Pipeline, eResProgramPipe);
+  SafetyTyped(d, state.VAO, eResVertexArray);
+  SafetyTyped(d, state.FeedbackObj, eResFeedback);
+  SafetyTyped(d, state.ReadFBO, eResFramebuffer);
+  SafetyTyped(d, state.DrawFBO, eResFramebuffer);
+  for(const auto &subroutine : state.Subroutines)
+    Require(subroutine.numSubroutines >= 0 &&
+                uint32_t(subroutine.numSubroutines) <= ARRAY_COUNT(subroutine.Values),
+            "snapshot subroutine count exceeds fixed GL argument capacity");
+}
+
+// Read and copy one exact byte array. Never invoke a pointer-array reader with
+// an unverified wire length. Re-encoding uses the archive's existing bytes, not
+// synthesized zeros or a reference rendering.
+static void SafetyRaw(ReadSerialiser &input, WriteSerialiser &output,
+                      const Bytes &blob, uint64_t expected)
+{
+  uint64_t count = 0;
+  input.Serialise("byte_count"_lit, count);
+  Require(!input.IsErrored() && count == expected,
+          "snapshot raw byte count exceeds/differs from exact capacity");
+  input.GetReader()->AlignTo<64>();
+  const uint64_t offset = input.GetReader()->GetOffset();
+  Require(offset <= blob.size() && count <= blob.size() - offset,
+          "snapshot raw byte span exceeds resource blob");
+  byte *data = const_cast<byte *>(blob.data() + size_t(offset));
+  output.Serialise("raw"_lit, data, count, SerialiserFlags::NoFlags);
+  input.GetReader()->SetOffset(offset + count);
+}
+
+static uint64_t SafetyCount(ReadSerialiser &ser, size_t limit)
+{
+  uint64_t count = 0;
+  ser.Serialise("count"_lit, count);
+  Require(!ser.IsErrored() && count <= limit, "snapshot program collection count exceeds blob bound");
+  return count;
+}
+
+static void SafetyProgramBindings(ReadSerialiser &ser, size_t length)
+{
+  const uint64_t count = SafetyCount(ser, length / 8);
+  for(uint64_t i = 0; i < count; ++i)
+  {
+    rdcstr name; int32_t binding = 0;
+    ser.Serialise("Name"_lit, name); ser.Serialise("Binding"_lit, binding);
+    Require(!ser.IsErrored() && name.size() <= length && binding >= -1 && binding < 64,
+            "snapshot program binding is malformed or exceeds codec bitmask width");
+  }
+}
+
+static uint32_t SafetyUniformComponents(GLenum type)
+{
+  switch(type)
+  {
+    case eGL_FLOAT_MAT4: case eGL_DOUBLE_MAT4: return 16;
+    case eGL_FLOAT_MAT4x3: case eGL_FLOAT_MAT3x4:
+    case eGL_DOUBLE_MAT4x3: case eGL_DOUBLE_MAT3x4: return 12;
+    case eGL_FLOAT_MAT4x2: case eGL_FLOAT_MAT2x4:
+    case eGL_DOUBLE_MAT4x2: case eGL_DOUBLE_MAT2x4: return 8;
+    case eGL_FLOAT_MAT3: case eGL_DOUBLE_MAT3: return 9;
+    case eGL_FLOAT_MAT3x2: case eGL_FLOAT_MAT2x3:
+    case eGL_DOUBLE_MAT3x2: case eGL_DOUBLE_MAT2x3: return 6;
+    case eGL_FLOAT_MAT2: case eGL_DOUBLE_MAT2:
+    case eGL_FLOAT_VEC4: case eGL_DOUBLE_VEC4: case eGL_INT_VEC4:
+    case eGL_UNSIGNED_INT_VEC4: case eGL_BOOL_VEC4: return 4;
+    case eGL_FLOAT_VEC3: case eGL_DOUBLE_VEC3: case eGL_INT_VEC3:
+    case eGL_UNSIGNED_INT_VEC3: case eGL_BOOL_VEC3: return 3;
+    case eGL_FLOAT_VEC2: case eGL_DOUBLE_VEC2: case eGL_INT_VEC2:
+    case eGL_UNSIGNED_INT_VEC2: case eGL_BOOL_VEC2: return 2;
+    default: return 1;
+  }
+}
+
+static bool SafetyDoubleUniform(GLenum type)
+{
+  switch(type)
+  {
+    case eGL_DOUBLE: case eGL_DOUBLE_VEC2: case eGL_DOUBLE_VEC3: case eGL_DOUBLE_VEC4:
+    case eGL_DOUBLE_MAT2: case eGL_DOUBLE_MAT3: case eGL_DOUBLE_MAT4:
+    case eGL_DOUBLE_MAT2x3: case eGL_DOUBLE_MAT2x4: case eGL_DOUBLE_MAT3x2:
+    case eGL_DOUBLE_MAT3x4: case eGL_DOUBLE_MAT4x2: case eGL_DOUBLE_MAT4x3: return true;
+    default: return false;
+  }
+}
+
+static bool SafetyFloatUniform(GLenum type)
+{
+  switch(type)
+  {
+    case eGL_FLOAT: case eGL_FLOAT_VEC2: case eGL_FLOAT_VEC3: case eGL_FLOAT_VEC4:
+    case eGL_FLOAT_MAT2: case eGL_FLOAT_MAT3: case eGL_FLOAT_MAT4:
+    case eGL_FLOAT_MAT2x3: case eGL_FLOAT_MAT2x4: case eGL_FLOAT_MAT3x2:
+    case eGL_FLOAT_MAT3x4: case eGL_FLOAT_MAT4x2: case eGL_FLOAT_MAT4x3: return true;
+    default: return false;
+  }
+}
+
+static bool SafetyIntegerUniform(GLenum type)
+{
+  // Keep this list aligned with ProgramUniformValue's signed/unsigned arms.
+  // In particular an unknown GLenum must not fall through the old-version
+  // float union encoding and desynchronise our capacity prewalk.
+  switch(type)
+  {
+    case eGL_SAMPLER_1D: case eGL_SAMPLER_2D: case eGL_SAMPLER_3D: case eGL_SAMPLER_CUBE:
+    case eGL_SAMPLER_CUBE_MAP_ARRAY: case eGL_SAMPLER_1D_SHADOW: case eGL_SAMPLER_2D_SHADOW:
+    case eGL_SAMPLER_1D_ARRAY: case eGL_SAMPLER_2D_ARRAY: case eGL_SAMPLER_1D_ARRAY_SHADOW:
+    case eGL_SAMPLER_2D_ARRAY_SHADOW: case eGL_SAMPLER_2D_MULTISAMPLE:
+    case eGL_SAMPLER_2D_MULTISAMPLE_ARRAY: case eGL_SAMPLER_CUBE_SHADOW:
+    case eGL_SAMPLER_CUBE_MAP_ARRAY_SHADOW: case eGL_SAMPLER_BUFFER:
+    case eGL_SAMPLER_2D_RECT: case eGL_SAMPLER_2D_RECT_SHADOW:
+    case eGL_INT_SAMPLER_1D: case eGL_INT_SAMPLER_2D: case eGL_INT_SAMPLER_3D:
+    case eGL_INT_SAMPLER_CUBE: case eGL_INT_SAMPLER_CUBE_MAP_ARRAY:
+    case eGL_INT_SAMPLER_1D_ARRAY: case eGL_INT_SAMPLER_2D_ARRAY:
+    case eGL_INT_SAMPLER_2D_MULTISAMPLE: case eGL_INT_SAMPLER_2D_MULTISAMPLE_ARRAY:
+    case eGL_INT_SAMPLER_BUFFER: case eGL_INT_SAMPLER_2D_RECT:
+    case eGL_UNSIGNED_INT_SAMPLER_1D: case eGL_UNSIGNED_INT_SAMPLER_2D:
+    case eGL_UNSIGNED_INT_SAMPLER_3D: case eGL_UNSIGNED_INT_SAMPLER_CUBE:
+    case eGL_UNSIGNED_INT_SAMPLER_CUBE_MAP_ARRAY: case eGL_UNSIGNED_INT_SAMPLER_1D_ARRAY:
+    case eGL_UNSIGNED_INT_SAMPLER_2D_ARRAY: case eGL_UNSIGNED_INT_SAMPLER_2D_MULTISAMPLE:
+    case eGL_UNSIGNED_INT_SAMPLER_2D_MULTISAMPLE_ARRAY: case eGL_UNSIGNED_INT_SAMPLER_BUFFER:
+    case eGL_UNSIGNED_INT_SAMPLER_2D_RECT:
+    case eGL_IMAGE_1D: case eGL_IMAGE_2D: case eGL_IMAGE_3D: case eGL_IMAGE_2D_RECT:
+    case eGL_IMAGE_CUBE: case eGL_IMAGE_BUFFER: case eGL_IMAGE_1D_ARRAY:
+    case eGL_IMAGE_2D_ARRAY: case eGL_IMAGE_CUBE_MAP_ARRAY:
+    case eGL_IMAGE_2D_MULTISAMPLE: case eGL_IMAGE_2D_MULTISAMPLE_ARRAY:
+    case eGL_INT_IMAGE_1D: case eGL_INT_IMAGE_2D: case eGL_INT_IMAGE_3D:
+    case eGL_INT_IMAGE_2D_RECT: case eGL_INT_IMAGE_CUBE: case eGL_INT_IMAGE_BUFFER:
+    case eGL_INT_IMAGE_1D_ARRAY: case eGL_INT_IMAGE_2D_ARRAY:
+    case eGL_INT_IMAGE_2D_MULTISAMPLE: case eGL_INT_IMAGE_2D_MULTISAMPLE_ARRAY:
+    case eGL_UNSIGNED_INT_IMAGE_1D: case eGL_UNSIGNED_INT_IMAGE_2D:
+    case eGL_UNSIGNED_INT_IMAGE_3D: case eGL_UNSIGNED_INT_IMAGE_2D_RECT:
+    case eGL_UNSIGNED_INT_IMAGE_CUBE: case eGL_UNSIGNED_INT_IMAGE_BUFFER:
+    case eGL_UNSIGNED_INT_IMAGE_1D_ARRAY: case eGL_UNSIGNED_INT_IMAGE_2D_ARRAY:
+    case eGL_UNSIGNED_INT_IMAGE_CUBE_MAP_ARRAY: case eGL_UNSIGNED_INT_IMAGE_2D_MULTISAMPLE:
+    case eGL_UNSIGNED_INT_IMAGE_2D_MULTISAMPLE_ARRAY: case eGL_UNSIGNED_INT_ATOMIC_COUNTER:
+    case eGL_INT: case eGL_INT_VEC2: case eGL_INT_VEC3: case eGL_INT_VEC4:
+    case eGL_UNSIGNED_INT: case eGL_UNSIGNED_INT_VEC2: case eGL_UNSIGNED_INT_VEC3:
+    case eGL_UNSIGNED_INT_VEC4: case eGL_BOOL: case eGL_BOOL_VEC2:
+    case eGL_BOOL_VEC3: case eGL_BOOL_VEC4: return true;
+    default: return false;
+  }
+}
+
+static void SafetyProgram(ReadSerialiser &input, WrappedOpenGL &d, const Resource &record)
+{
+  // This direct bounded wire walk MUST precede SemanticProgram or the ordinary
+  // ProgramUniformValue decoder: both use NoFlags into its fixed data[16].
+  SafetyProgramBindings(input, record.blob.size());
+  SafetyProgramBindings(input, record.blob.size());
+  const uint64_t uniforms = SafetyCount(input, record.blob.size() / 13);
+  for(uint64_t i = 0; i < uniforms; ++i)
+  {
+    rdcstr name; bool array = false;
+    input.Serialise("Basename"_lit, name); input.Serialise("IsArray"_lit, array);
+    Require(!input.IsErrored() && name.size() <= record.blob.size(), "snapshot malformed uniform name");
+    const uint64_t values = SafetyCount(input, record.blob.size() / 20);
+    for(uint64_t j = 0; j < values; ++j)
+    {
+      GLenum type = eGL_NONE; int32_t location = 0;
+      input.Serialise("Type"_lit, type); input.Serialise("Location"_lit, location);
+      Require(SafetyFloatUniform(type) || SafetyDoubleUniform(type) || SafetyIntegerUniform(type),
+              "snapshot uniform type has no validated capacity codec");
+      const uint64_t components = SafetyCount(input, 16);
+      Require(components == SafetyUniformComponents(type), "snapshot uniform count/capacity mismatch");
+      // Older RenderDoc sections stored float/double data in the opposite
+      // union member. Preserve the codec's versioned physical layout exactly.
+      const bool wide = input.VersionAtLeast(0x1C) ? SafetyDoubleUniform(type) : SafetyFloatUniform(type);
+      const uint64_t bytes = components * (wide ? 8U : 4U);
+      const uint64_t offset = input.GetReader()->GetOffset();
+      Require(!input.IsErrored() && offset <= record.blob.size() && bytes <= record.blob.size() - offset,
+              "snapshot uniform data span exceeds blob");
+      input.GetReader()->SetOffset(offset + bytes);
+    }
+  }
+  SafetyProgramBindings(input, record.blob.size());
+  SafetyProgramBindings(input, record.blob.size());
+  Finish(input, record.blob.size());
+
+  // Now the existing structured helpers are safe to invoke. Re-encode every
+  // value, including process-local Location, for wire/capacity verification;
+  // semantic comparison later intentionally normalizes Location separately.
+  ReadSerialiser structured(new StreamReader(record.blob.data(), record.blob.size()), Ownership::Stream);
+  SafetyStructured(structured, d);
+  Require(structured.ReadChunk<SystemChunk>() == SystemChunk::InitialContents,
+          "snapshot program chunk mismatch");
+  ResourceId id; GLNamespace type;
+  structured.Serialise("id"_lit, id); structured.Serialise("Type"_lit, type);
+  PerStageReflections stages; d.FillReflectionArray(id, stages);
+  SerialiseProgramBindings(structured, CaptureState::StructuredExport, stages, 0);
+  SerialiseProgramUniforms(structured, CaptureState::StructuredExport, stages, 0, NULL);
+  Finish(structured, record.blob.size());
+  WriteSerialiser encoded(new StreamWriter(4096), Ownership::Stream); Setup(encoded, d);
+  encoded.WriteStructuredFile(structured.GetStructuredFile(), NULL);
+  Require(StreamBytes(encoded) == record.blob, "snapshot program encoding/counts are not canonical");
+}
+
+static void SafetyPreflightResource(WrappedOpenGL &d, const Resource &record)
+{
+  if(record.type == eResShader || record.type == eResQuery)
+  { Require(record.blob.empty(), "snapshot immutable/query resource has unexpected bytes"); return; }
+  Require(!record.blob.empty() && record.blob.size() <= replay_snapshot::MaxBlob,
+          "snapshot missing or oversized resource blob");
+  ReadSerialiser input(new StreamReader(record.blob.data(), record.blob.size()), Ownership::Stream);
+  SafetyStructured(input, d);
+  Require(input.ReadChunk<SystemChunk>() == SystemChunk::InitialContents,
+          "snapshot resource chunk mismatch");
+  ResourceId id; GLNamespace type;
+  input.Serialise("id"_lit, id); input.Serialise("Type"_lit, type);
+  Require(!input.IsErrored() && id == record.id && type == record.type,
+          "snapshot embedded resource identity mismatch");
+  if(type == eResProgram) { SafetyProgram(input, d, record); return; }
+
+  WriteSerialiser output(new StreamWriter(4096), Ownership::Stream); Setup(output, d);
+  output.BeginChunk(uint32_t(SystemChunk::InitialContents), 0);
+  output.Serialise("id"_lit, id); output.Serialise("Type"_lit, type);
+  switch(type)
+  {
+    case eResBuffer:
+    {
+      uint32_t bytes = 0; input.Serialise("BufferContentsSize"_lit, bytes);
+      Reader signature(record.signature); signature.U64();
+      Require(bytes == signature.U64() && bytes <= replay_snapshot::MaxBlob,
+              "snapshot buffer extent differs from validated storage");
+      output.Serialise("BufferContentsSize"_lit, bytes);
+      SafetyRaw(input, output, record.blob, bytes);
+      break;
+    }
+    case eResTexture:
+    {
+      TextureStateInitialData texture = {};
+      input.Serialise("TextureState"_lit, texture);
+      const auto &original = d.m_Textures.at(id);
+      Reader signature(record.signature);
+      for(int field = 0; field < 11; ++field) signature.U64();
+      const uint64_t physicalMips = signature.U64();
+      Require(!input.IsErrored() && !texture.isView && texture.samples <= 1 &&
+                  texture.type == original.curType && texture.internalformat == original.internalFormat &&
+                  texture.width == uint32_t(original.width) && texture.height == uint32_t(original.height) &&
+                  texture.depth == uint32_t(original.depth) && texture.dim == uint32_t(original.dimension) &&
+                  texture.mips > 0 && texture.mips <= 16 && uint64_t(texture.mips) == physicalMips,
+              "snapshot texture metadata differs from validated storage");
+      SafetyTyped(d, texture.texBuffer, eResBuffer);
+      output.Serialise("TextureState"_lit, texture);
+      if(texture.type != eGL_TEXTURE_BUFFER)
+        for(int mip = 0; mip < texture.mips; ++mip)
+        {
+          const uint32_t w = RDCMAX(1U, texture.width >> mip);
+          const uint32_t h = RDCMAX(1U, texture.height >> mip);
+          const uint32_t depth = texture.type == eGL_TEXTURE_2D_ARRAY || texture.type == eGL_TEXTURE_CUBE_MAP_ARRAY ?
+              texture.depth : RDCMAX(1U, texture.depth >> mip);
+          const uint64_t bytes = IsCompressedFormat(texture.internalformat) ?
+              GetCompressedByteSize(w, h, depth, texture.internalformat) :
+              GetByteSize(w, h, depth, GetBaseFormat(texture.internalformat), GetDataType(texture.internalformat));
+          Require(bytes && bytes <= record.blob.size(), "snapshot texture subresource size bound");
+          for(int face = 0; face < (texture.type == eGL_TEXTURE_CUBE_MAP ? 6 : 1); ++face)
+            SafetyRaw(input, output, record.blob, bytes);
+        }
+      break;
+    }
+    case eResVertexArray:
+    {
+      VAOInitialData state = {};
+      input.Serialise("VAOState"_lit, state);
+      Require(state.valid, "snapshot invalid VAO metadata");
+      for(auto buffer : state.VertexBuffers) SafetyTyped(d, buffer.Buffer, eResBuffer);
+      SafetyTyped(d, state.ElementArrayBuffer, eResBuffer);
+      output.Serialise("VAOState"_lit, state);
+      break;
+    }
+    case eResFramebuffer:
+    {
+      FramebufferInitialData state = {};
+      input.Serialise("FramebufferState"_lit, state);
+      Require(state.valid, "snapshot invalid framebuffer metadata");
+      for(auto attachment : state.Attachments) SafetyTyped(d, attachment.obj, eResTexture);
+      output.Serialise("FramebufferState"_lit, state);
+      break;
+    }
+    case eResFeedback:
+    {
+      FeedbackInitialData state = {};
+      input.Serialise("TransformFeedbackState"_lit, state);
+      Require(state.valid, "snapshot invalid feedback metadata");
+      for(auto buffer : state.Buffer) SafetyTyped(d, buffer, eResBuffer);
+      output.Serialise("TransformFeedbackState"_lit, state);
+      break;
+    }
+    case eResProgramPipe:
+    {
+      PipelineInitialData state = {};
+      input.Serialise("ProgramPipelineState"_lit, state);
+      Require(state.valid, "snapshot invalid pipeline metadata");
+      for(auto program : state.programs) SafetyTyped(d, program, eResProgram);
+      output.Serialise("ProgramPipelineState"_lit, state);
+      break;
+    }
+    case eResSampler:
+    {
+      SamplerInitialData state = {};
+      input.Serialise("SamplerState"_lit, state);
+      Require(state.valid, "snapshot invalid sampler metadata");
+      output.Serialise("SamplerState"_lit, state);
+      break;
+    }
+    default: Require(false, "snapshot resource has no safe preflight codec");
+  }
+  Require(!input.IsErrored(), "snapshot metadata decode failed");
+  Finish(input, record.blob.size());
+  output.EndChunk();
+  Require(StreamBytes(output) == record.blob, "snapshot resource encoding/counts are not canonical");
+}
