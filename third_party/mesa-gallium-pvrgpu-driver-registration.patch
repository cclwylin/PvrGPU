index 030f615..5c6156a 100644
--- a/src/gallium/auxiliary/target-helpers/sw_helper.h
+++ b/src/gallium/auxiliary/target-helpers/sw_helper.h
@@ -28,6 +28,10 @@
 #include "llvmpipe/lp_public.h"
 #endif
 
+#ifdef GALLIUM_PVRGPU
+#include "pvrgpu/pvrgpu_public.h"
+#endif
+
 #ifdef GALLIUM_VIRGL
 #include "virgl/virgl_public.h"
 #include "virgl/vtest/virgl_vtest_public.h"
@@ -38,6 +42,11 @@ sw_screen_create_named(struct sw_winsys *winsys, const struct pipe_screen_config
 {
    struct pipe_screen *screen = NULL;
 
+#if defined(GALLIUM_PVRGPU)
+   if (screen == NULL && strcmp(driver, "pvrgpu") == 0)
+      screen = pvrgpu_create_screen(winsys, config);
+#endif
+
 #if defined(GALLIUM_LLVMPIPE)
    if (screen == NULL && (strcmp(driver, "llvmpipe") == 0 || !driver[0]))
       screen = llvmpipe_create_screen(winsys);
