Subject: [PATCH] mesa: retain explicit failed query state instead of polling forever

Applies to Mesa 26.2.1 commit da14d65e4499e66468094be52bff9ea0915a695e.
Upstream file copyrights and MIT notices are preserved.

Gallium begin/end_query false already causes GL_OUT_OF_MEMORY in Mesa. Keep
that failure on the GL query object, retire the underlying Gallium queries,
and balance active_queries when EndQuery has already deactivated/unbound it.
Reads and conditional rendering report the failure without touching result
memory or declaring a ready zero. Rebegin and QueryCounter reset the failed
state; failed BeginQuery also releases its binding point. Ordinary pending
queries retain their existing wait behavior.

OpenGL ES 3.2 section 2.3.1 explicitly leaves operation results undefined
after OUT_OF_MEMORY; the usual unchanged-state-on-error rule does not apply.
This patch chooses a recoverable terminal query state and preserves the
existing GL error rather than inventing successful shader/query results.
Source: https://registry.khronos.org/OpenGL/specs/es/3.2/es_spec_3.2.pdf

Apply with git apply to either Mesa backend before building; this is not a
PvrGPU-specific shader or CTS workaround. No query-result oracle is changed.

diff --git a/src/mesa/main/condrender.c b/src/mesa/main/condrender.c
index 17ebc0b..67cc03d 100644
--- a/src/mesa/main/condrender.c
+++ b/src/mesa/main/condrender.c
@@ -158,6 +158,11 @@ begin_conditional_render(struct gl_context *ctx, GLuint queryId, GLenum mode,
       }
    }
 
+   if (q && q->Failed) {
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "glBeginConditionalRender(query failed)");
+      return;
+   }
+
    ctx->Query.CondRenderQuery = q;
    ctx->Query.CondRenderMode = mode;
 
diff --git a/src/mesa/main/mtypes.h b/src/mesa/main/mtypes.h
index 5822d53..00ac113 100644
--- a/src/mesa/main/mtypes.h
+++ b/src/mesa/main/mtypes.h
@@ -2337,6 +2337,7 @@ struct gl_query_object
    GLboolean Active;   /**< inside Begin/EndQuery */
    GLboolean Ready;    /**< result is ready? */
    GLboolean EverBound;/**< has query object ever been bound */
+   GLboolean Failed;   /**< Gallium begin/end failed; no valid result exists */
    GLuint Stream;      /**< The stream */
 
    struct pipe_query *pq;
diff --git a/src/mesa/main/queryobj.c b/src/mesa/main/queryobj.c
index 074a008..7320e66 100644
--- a/src/mesa/main/queryobj.c
+++ b/src/mesa/main/queryobj.c
@@ -242,6 +242,7 @@ begin_query(struct gl_context *ctx, struct gl_query_object *q)
    if (!ret) {
       _mesa_error(ctx, GL_OUT_OF_MEMORY, "glBeginQuery");
 
+      q->Failed = GL_TRUE;
       free_queries(pipe, q);
       q->Active = GL_FALSE;
       return;
@@ -276,13 +277,17 @@ end_query(struct gl_context *ctx, struct gl_query_object *q)
    } else if (q->pq)
       ret = pipe->end_query(pipe, q->pq);
 
+   if (q->type != PIPE_QUERY_TIMESTAMP)
+      st->active_queries--;
+
    if (!ret) {
+      /* EndQuery has already unbound/deactivated the GL object. An explicit
+       * Gallium failure is terminal, not a perpetually pending result. */
+      q->Failed = GL_TRUE;
+      q->Ready = GL_FALSE;
+      free_queries(pipe, q);
       _mesa_error(ctx, GL_OUT_OF_MEMORY, "glEndQuery");
-      return;
    }
-
-   if (q->type != PIPE_QUERY_TIMESTAMP)
-      st->active_queries--;
 }
 
 
@@ -384,6 +389,11 @@ _mesa_wait_query(struct gl_context *ctx, struct gl_query_object *q)
 {
    struct pipe_context *pipe = ctx->pipe;
 
+   if (q->Failed) {
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "waiting for failed query");
+      return;
+   }
+
    /* this function should only be called if we don't have a ready result */
    assert(!q->Ready);
 
@@ -401,6 +411,10 @@ void
 _mesa_check_query(struct gl_context *ctx, struct gl_query_object *q)
 {
    struct pipe_context *pipe = ctx->pipe;
+   if (q->Failed) {
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "checking failed query");
+      return;
+   }
    assert(!q->Ready);   /* we should not get called if Ready is TRUE */
    q->Ready = get_query_result(pipe, q, false);
 }
@@ -823,6 +837,7 @@ _mesa_BeginQueryIndexed(GLenum target, GLuint index, GLuint id)
    q->Active = GL_TRUE;
    q->Result = 0;
    q->Ready = GL_FALSE;
+   q->Failed = GL_FALSE;
    q->EverBound = GL_TRUE;
    q->Stream = index;
 
@@ -830,6 +845,8 @@ _mesa_BeginQueryIndexed(GLenum target, GLuint index, GLuint id)
    *bindpt = q;
 
    begin_query(ctx, q);
+   if (!q->Active)
+      *bindpt = NULL;
 }
 
 
@@ -943,6 +960,7 @@ _mesa_QueryCounter(GLuint id, GLenum target)
    q->Target = target;
    q->Result = 0;
    q->Ready = GL_FALSE;
+   q->Failed = GL_FALSE;
    q->EverBound = GL_TRUE;
 
    /* QueryCounter is implemented using EndQuery without BeginQuery
@@ -1118,6 +1136,13 @@ get_query_object(struct gl_context *ctx, const char *func,
       return;
    }
 
+   /* Never turn a failed query into a successful zero, including the query
+    * buffer path. Leave caller memory and the buffer contents untouched. */
+   if (q->Failed) {
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "%s(query failed)", func);
+      return;
+   }
+
    /* From GL_EXT_occlusion_query_boolean spec:
     *
     *    "Accepted by the <pname> parameter of GetQueryObjectivEXT and
