# Copy this file to config/local.env and adjust it for the current host.
# The real local.env is intentionally ignored by version control.

# Keep generated files outside the source/iCloud tree.
PVRGPU_WORK_ROOT="${HOME}/Downloads/_Codex/Working/PvrGPU"
PVRGPU_BUILD_DIR="${PVRGPU_WORK_ROOT}/build"
PVRGPU_UI_VENV="${PVRGPU_WORK_ROOT}/venv"
PVRGPU_UI_PYTHON="${PVRGPU_UI_VENV}/bin/python"
PVRGPU_RDC_ROOT="${HOME}/Downloads/_Codex/Working/GPU_TestPatterns/1.GLBench"

# ChromeOS GLBench Mesa/surfaceless runner.
PVRGPU_GLBENCH_SOURCE_DIR="${PVRGPU_WORK_ROOT}/third_party/glbench-src"
PVRGPU_GLBENCH_RUNNER="${PVRGPU_BUILD_DIR}/bin/glbench-mesa"

# Counter-enabled Mesa llvmpipe install prefix consumed by the native player.
PVRGPU_LLVMPIPE_MESA_PREFIX="${PVRGPU_WORK_ROOT}/mesa-counter/install"

# Mesa/POC source tree used for PvrGPU Gallium bring-up.
PVRGPU_MESA_POC_ROOT="${PVRGPU_WORK_ROOT}/mesa-poc"
PVRGPU_MESA_POC_SOURCE_DIR="${PVRGPU_MESA_POC_ROOT}/src"
PVRGPU_MESA_PVRGPU_BUILD_DIR="${PVRGPU_WORK_ROOT}/build/mesa-pvrgpu"
PVRGPU_MESA_PVRGPU_PREFIX="${PVRGPU_WORK_ROOT}/mesa-pvrgpu/install"

# VK-GL-CTS checkout and the composite live dEQP runner. The checkout commit
# used by this repository is recorded in third_party/vk-gl-cts.lock.
PVRGPU_DEQP_SOURCE_DIR="${PVRGPU_WORK_ROOT}/third_party/VK-GL-CTS"
PVRGPU_DEQP_RUNNER="${PVRGPU_BUILD_DIR}/bin/pvrgpu-deqp"
PVRGPU_DEQP_UI_OUTPUT_ROOT="${PVRGPU_WORK_ROOT}/out/deqp-live-ui"

# Native single-RDC players are resolved from PVRGPU_BUILD_DIR. These explicit
# overrides use macOS/Linux names; add .exe when setting them on Windows.
PVRGPU_RDC_GOLDEN_RUNNER="${PVRGPU_BUILD_DIR}/bin/llvmpipe"
PVRGPU_RDC_PVRGPU_RUNNER="${PVRGPU_BUILD_DIR}/bin/pvrgpu"

# Optional native PvrGPU Mesa prefix and separately linked GLBench runner.
PVRGPU_NATIVE_MESA_PREFIX=
PVRGPU_NATIVE_GLBENCH_RUNNER=

# Event-driven SystemC stub produced by the CMake build.
PVRGPU_MODEL_STUB="${PVRGPU_BUILD_DIR}/bin/pvrgpu-model-stub"
# Optional override. Empty means the native runner resolves the platform's
# pvrgpu_systemc_bridge shared library from PVRGPU_BUILD_DIR/lib.
PVRGPU_SYSTEMC_API_LIB=

# Output, temporary files, and app logs.
PVRGPU_OUTPUT_ROOT="${PVRGPU_WORK_ROOT}/out/runs"
PVRGPU_TMP_ROOT="${PVRGPU_WORK_ROOT}/tmp"
PVRGPU_LOG_DIR="${PVRGPU_WORK_ROOT}/logs"
